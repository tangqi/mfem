# ITER.msh with real nonconformity, generated with MFEM's own refinement
# (Mesh::EnsureNCMesh + Mesh::GeneralRefinement, nonconforming, no level limit):
#   1) every element with centroid R > 1.0 refined once (includes boundary elements)
#   2) leaves with centroid R > 1.0 within 0.08 of (R, Z) = (1.0, 0.0) refined again
#   3) leaves with centroid R > 1.0 within 0.04 of (R, Z) = (1.0, 0.0) refined again
# Up to 3 refinement levels. Near (1.0, 0.0), level-0 elements on the R < 1.0 side
# border level-1 to level-3 elements, so hanging nodes also sit on hanging edges.

# NCMesh supported geometry types:
# SEGMENT     = 1
# TRIANGLE    = 2
# SQUARE      = 3
# TETRAHEDRON = 4
# CUBE        = 5
# PRISM       = 6
# PYRAMID     = 7

